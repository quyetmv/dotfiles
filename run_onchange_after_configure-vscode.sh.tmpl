#!/usr/bin/env bash
set -euo pipefail

log_info() { echo -e "\033[34m[INFO]\033[0m $*"; }

FONT_NAME="MesloLGS NF"

configure_vscode_font() {
    local settings_file="$1"

    if [[ ! -f "$settings_file" ]]; then
        [[ -d "$(dirname "$settings_file")" ]] || return 0
        log_info "Creating VS Code settings.json with terminal font..."
        printf '{\n    "terminal.integrated.fontFamily": "%s"\n}\n' "$FONT_NAME" > "$settings_file"
        return 0
    fi

    log_info "Configuring VS Code terminal font in $settings_file..."

    # VS Code uses JSONC (supports // comments) — jq can't parse it.
    # Use python3 to strip comments before reading.
    local current_font
    current_font=$(python3 -c "
import re, json, sys
try:
    content = open(sys.argv[1]).read()
    content = re.sub(r'//[^\n]*', '', content)
    content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
    print(json.loads(content).get('terminal.integrated.fontFamily', ''))
except Exception:
    print('')
" "$settings_file" 2>/dev/null)

    [[ "$current_font" == "$FONT_NAME" ]] && return 0

    cp "$settings_file" "${settings_file}.bak"

    if grep -q '"terminal.integrated.fontFamily"' "$settings_file"; then
        # Key exists — sed replacement preserves all comments and file structure
        {{- if eq .chezmoi.os "darwin" }}
        sed -i '' "s|\"terminal.integrated.fontFamily\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"terminal.integrated.fontFamily\": \"$FONT_NAME\"|" "$settings_file"
        {{- else }}
        sed -i "s|\"terminal.integrated.fontFamily\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"terminal.integrated.fontFamily\": \"$FONT_NAME\"|" "$settings_file"
        {{- end }}
    else
        # Key missing — python3 adds it (JSONC → clean JSON, comments in other lines preserved via sed workaround)
        python3 -c "
import re, json, sys
settings_file, font_name = sys.argv[1], sys.argv[2]
content = open(settings_file).read()
stripped = re.sub(r'//[^\n]*', '', content)
stripped = re.sub(r'/\*.*?\*/', '', stripped, flags=re.DOTALL)
data = json.loads(stripped)
data['terminal.integrated.fontFamily'] = font_name
with open(settings_file, 'w') as f:
    json.dump(data, f, indent=4, ensure_ascii=False)
    f.write('\n')
" "$settings_file" "$FONT_NAME" || { log_info "⚠ Could not update VS Code settings, skipping"; return 0; }
    fi

    log_info "VS Code terminal font updated."
}

configure_vscode_font "$HOME/.vscode-server/data/Machine/settings.json"
configure_vscode_font "$HOME/.config/Code/User/settings.json"
configure_vscode_font "$HOME/Library/Application Support/Code/User/settings.json"
