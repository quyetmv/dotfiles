#!/usr/bin/env bash
# This script generates work-specific git configs dynamically
# based on the work_configs list in chezmoi data.

set -euo pipefail

ensure_gpg_key() {
  local key_id="$1"
  [[ -z "$key_id" ]] && return 0
  command -v gpg >/dev/null 2>&1 || return 0

  if gpg --list-secret-keys "$key_id" >/dev/null 2>&1; then
    return 0
  fi

  echo "🔑 GPG secret key $key_id not in keyring, attempting import from Bitwarden..."
  local _BW_PORT=8087
  local item=""

  _awk_format_pgp() {
    awk '{
      for (i = 1; i <= NF; i++) {
        if ($i == "-----BEGIN") {
          hdr = $i; while (i <= NF && substr($i, length($i)-4) != "-----") { i++; hdr = hdr " " $i; }
          print hdr "\n";
        } else if ($i == "-----END") {
          ftr = $i; while (i <= NF && substr($i, length($i)-4) != "-----") { i++; ftr = ftr " " $i; }
          print ftr;
        } else {
          print $i;
        }
      }
    }' <<< "$1"
  }

  # 1. Try local REST API
  if curl -sf "http://localhost:${_BW_PORT}/status" 2>/dev/null | jq -e '.data.template.status == "unlocked"' >/dev/null 2>&1; then
    item="$(curl -sf "http://localhost:${_BW_PORT}/list/object/items?search=GPG+-+$key_id" 2>/dev/null \
      | jq -r --arg n "GPG - $key_id" '.data.data[] | select(.name == $n)' 2>/dev/null || true)"
    if [[ -z "$item" || "$item" == "null" ]]; then
      item="$(curl -sf "http://localhost:${_BW_PORT}/list/object/items?search=$key_id" 2>/dev/null \
        | jq -r --arg id "$key_id" '.data.data[] | select(.name | contains($id))' 2>/dev/null || true)"
    fi
  fi

  # 2. Try bw CLI if REST API was unavailable
  if [[ -z "$item" || "$item" == "null" ]] && command -v bw >/dev/null 2>&1; then
    item="$(bw get item "GPG - $key_id" 2>/dev/null || bw get item "$key_id" 2>/dev/null || true)"
  fi

  if [[ -n "$item" && "$item" != "null" ]]; then
    local priv pub
    priv="$(printf '%s' "$item" | jq -r '.fields[]? | select(.name | contains("SECRET")) | .value' 2>/dev/null || true)"
    pub="$(printf '%s' "$item" | jq -r '.fields[]? | select(.name | contains("PUBLIC")) | .value' 2>/dev/null || true)"
    if [[ -n "$priv" && "$priv" != "null" ]]; then
      [[ -n "$pub" && "$pub" != "null" ]] && _awk_format_pgp "$pub" | gpg --batch --import >/dev/null 2>&1 || true
      if _awk_format_pgp "$priv" | gpg --batch --import >/dev/null 2>&1; then
        local fpr
        fpr="$(gpg --list-secret-keys --with-colons "$key_id" 2>/dev/null | grep "^fpr" | head -n1 | cut -d: -f10 || true)"
        [[ -n "$fpr" ]] && (echo "${fpr}:6:") | gpg --import-ownertrust >/dev/null 2>&1 || true
        echo "✓ GPG key $key_id imported and trusted from Bitwarden"
        return 0
      fi
    fi
  fi

  echo "⚠️  Could not import GPG key $key_id from Bitwarden. Import manually or run 'bwu && bwgpgkey $key_id'."
}

{{- $personalSigningKey := get . "signing_key" | default (get . "signingkey" | default "") }}
{{- if $personalSigningKey }}
ensure_gpg_key {{ $personalSigningKey | quote }}
{{- end }}

{{- if hasKey . "work_configs" }}
declare -a expected_files=()
{{- range $i, $config := .work_configs }}
{{- if $config.dir }}
{{- $label := get $config "label" | default (printf "work-%d" (add $i 1)) }}
echo "🔧 Generating git config for {{ $config.dir }} -> ~/.gitconfig-{{ $label }}"
# Auto-create the directory so the workspace actually exists
mkdir -p {{ $config.dir }}
cat > "$HOME/.gitconfig-{{ $label }}" <<EOF
# Generated by chezmoi - DO NOT EDIT DIRECTLY
[user]
  name = {{ $config.name | default $.name }}
  email = {{ $config.email | default $.email }}
{{- $signingKey := get $config "signing_key" | default (get $config "signingkey" | default "") }}
{{- if $signingKey }}
  signingkey = {{ $signingKey }}
[commit]
  gpgsign = true
[tag]
  gpgsign = true
{{- end }}
EOF
{{- if $signingKey }}
ensure_gpg_key {{ $signingKey | quote }}
{{- end }}
expected_files+=("$HOME/.gitconfig-{{ $label }}")
{{- end }}
{{- end }}

# Remove stale generated work configs (e.g. old ~/.gitconfig-work-N from a
# renamed/removed label) so leftover identities don't linger unreferenced.
for f in "$HOME"/.gitconfig-*; do
  [[ -f "$f" ]] || continue
  [[ "$f" == "$HOME/.gitconfig-personal" ]] && continue
  grep -q "Generated by chezmoi" "$f" 2>/dev/null || continue
  printf '%s\n' "${expected_files[@]-}" | grep -qxF "$f" && continue
  echo "🧹 Removing stale work git config: $f"
  rm -f "$f"
done
{{- end }}
