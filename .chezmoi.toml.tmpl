{{- $interactive := not (or (env "CI") (env "GITHUB_ACTIONS")) -}}
{{- $enableDock := eq (env "CHEZMOI_ENABLE_DOCK") "1" -}}
{{- $enableMasApps := eq (env "CHEZMOI_ENABLE_MAS_APPS") "1" -}}
{{- $enablePersonalApps := eq (env "CHEZMOI_ENABLE_PERSONAL_APPS") "1" -}}
{{- $enableSshKeygen := eq (env "CHEZMOI_ENABLE_SSH_KEYGEN") "1" -}}
{{- if $interactive -}}
{{-   $enableDock = promptBool "Enable Dock customization? (macOS only)" -}}
{{-   $enableMasApps = promptBool "Enable Mac App Store apps?" -}}
{{-   $enablePersonalApps = promptBool "Enable personal apps (evkey, Telegram, etc.)?" -}}
{{-   $enableSshKeygen = promptBool "Generate SSH key?" -}}
{{- end -}}

{{- $email := env "CHEZMOI_GIT_EMAIL" -}}
{{- $name := env "CHEZMOI_GIT_NAME" -}}
{{- $githubUser := env "CHEZMOI_GITHUB_USER" -}}
{{- $enablePersonal := true -}}

{{- if $interactive -}}
{{-   $enablePersonal = promptBool "Do you want to configure a personal Git account? (y/n)" -}}
{{- end -}}

{{- if $enablePersonal -}}
{{-   if and (not $email) $interactive -}}
{{-     $email = promptString "Git email address (Personal)" -}}
{{-   end -}}
{{-   if and (not $name) $interactive -}}
{{-     $name = promptString "Git full name (Personal)" -}}
{{-   end -}}
{{-   if and (not $githubUser) $interactive -}}
{{-     $githubUser = promptString "GitHub username (Personal)" -}}
{{-   end -}}
{{- end -}}

{{- $workConfigs := list -}}
{{- $enableWork := true -}}
{{- if $interactive -}}
{{-   $enableWork = promptBool "Do you want to configure Work Git accounts? (y/n)" -}}
{{- end -}}

{{- $sshBastions := list -}}
{{- if $interactive -}}
{{-   $bastionCount := promptInt "How many SSH bastion configurations? (0 to skip)" -}}
{{-   range until (int $bastionCount) -}}
{{-     $bName := promptString "Bastion name (e.g. prod, staging)" -}}
{{-     $bRange := promptString (printf "IP range for '%s' (e.g. 10.110.15.*)" $bName) -}}
{{-     $bHost := promptString (printf "Bastion host IP for '%s'" $bName) -}}
{{-     $sshBastions = append $sshBastions (dict "name" $bName "range" $bRange "bastion" $bHost) -}}
{{-   end -}}
{{- end -}}

{{- if $enableWork -}}
{{-   if $interactive -}}
{{-     $workCount := promptInt "How many work configurations do you have? (0, 1, 2...)" -}}
{{-     $workCountInt := int $workCount -}}
{{-     if gt $workCountInt 0 -}}
{{-       range $i := until $workCountInt -}}
{{-         $idx := add $i 1 -}}
{{-         $dir := promptString (printf "DIRECTORY for Work %d (e.g. ~/company%d)" $idx $idx) -}}
{{-         $email := promptString (printf "Git email address for Work %d" $idx) -}}
{{-         $name := promptString (printf "Git full name for Work %d [Default: same as Personal]" $idx) -}}
{{-         $workConfigs = append $workConfigs (dict "dir" $dir "email" $email "name" $name) -}}
{{-       end -}}
{{-     end -}}
{{-   else -}}
{{/* Fallback to env vars for CI/non-interactive mode */}}
{{-     $workGitDir := env "CHEZMOI_WORK_GIT_DIR" -}}
{{-     if $workGitDir -}}
{{-       $workEmail := env "CHEZMOI_WORK_GIT_EMAIL" -}}
{{-       $workName := env "CHEZMOI_WORK_GIT_NAME" -}}
{{-       $workConfigs = append $workConfigs (dict "dir" $workGitDir "email" $workEmail "name" $workName) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

encryption = "age"
sourceDir = "~/workspace/personal/projects/dotfiles"

[data]
    email = {{ printf "%q" $email }}
    github_user = {{ printf "%q" $githubUser }}
    name = {{ printf "%q" $name }}
    
    # Work Configurations
    work_configs = [
        {{- range $i, $config := $workConfigs }}
        { dir = {{ printf "%q" $config.dir }}, name = {{ printf "%q" $config.name }}, email = {{ printf "%q" $config.email }} },
        {{- end }}
    ]
    enable_dock = {{ $enableDock }}
    enable_mas_apps = {{ $enableMasApps }}
    enable_personal_apps = {{ $enablePersonalApps }}
    enable_ssh_keygen = {{ $enableSshKeygen }}
    ssh_bastions = [
        {{- range $sshBastions }}
        { name = {{ printf "%q" .name }}, range = {{ printf "%q" .range }}, bastion = {{ printf "%q" .bastion }} },
        {{- end }}
    ]

[apply]
    backup = true

[age]
    identity = "~/.config/chezmoi/chezmoi_private_key"
    recipient = "age1tc9lzhe5dtptgc7svn5mw0d062fnuav4zfgck8pft84dpc2vydzqak5hsa"

[edit]
    command = "nvim"
