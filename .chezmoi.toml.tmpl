{{- $interactive := not (or (env "CI") (env "GITHUB_ACTIONS")) -}}
{{- $enableDock := eq (env "CHEZMOI_ENABLE_DOCK") "1" -}}
{{- $enableMasApps := eq (env "CHEZMOI_ENABLE_MAS_APPS") "1" -}}
{{- $enablePersonalApps := eq (env "CHEZMOI_ENABLE_PERSONAL_APPS") "1" -}}
{{- $enableSshKeygen := eq (env "CHEZMOI_ENABLE_SSH_KEYGEN") "1" -}}
{{- $enableMacKeybindings := eq (env "CHEZMOI_ENABLE_MAC_KEYBINDINGS") "1" -}}
{{- if $interactive -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     $enableDock = promptBool "Enable Dock customization?" (get . "enable_dock" | default false) -}}
{{-     $enableMasApps = promptBool "Enable Mac App Store apps?" (get . "enable_mas_apps" | default false) -}}
{{-     $enablePersonalApps = promptBool "Enable personal apps (evkey, Telegram, etc.)?" (get . "enable_personal_apps" | default true) -}}
{{-   end -}}
{{-   if eq .chezmoi.os "linux" -}}
{{-     $enableMacKeybindings = promptBool "Map macOS-style keybindings in Terminator (Cmd+T/W/C/V/...)?" (get . "enable_mac_keybindings" | default false) -}}
{{-   end -}}
{{-   $enableSshKeygen = promptBool "Generate SSH key?" (get . "enable_ssh_keygen" | default false) -}}
{{- end -}}

{{- $email := env "CHEZMOI_GIT_EMAIL" -}}
{{- $name := env "CHEZMOI_GIT_NAME" -}}
{{- $githubUser := env "CHEZMOI_GITHUB_USER" -}}
{{- $signingKey := env "CHEZMOI_GIT_SIGNING_KEY" -}}
{{- $enablePersonal := true -}}

{{- if $interactive -}}
{{-   $enablePersonal = promptBool "Do you want to configure a personal Git account? (y/n)" (hasKey . "email") -}}
{{- end -}}

{{- if $enablePersonal -}}
{{-   if and (not $email) $interactive -}}
{{-     $email = promptString "Git email address (Personal)" (get . "email" | default "") -}}
{{-   end -}}
{{-   if and (not $name) $interactive -}}
{{-     $name = promptString "Git full name (Personal)" (get . "name" | default "") -}}
{{-   end -}}
{{-   if and (not $githubUser) $interactive -}}
{{-     $githubUser = promptString "GitHub username (Personal)" (get . "github_user" | default "") -}}
{{-   end -}}
{{-   if not $signingKey -}}
{{-     $signingKey = get . "signing_key" | default "" -}}
{{-   end -}}
{{- end -}}

{{- $workConfigs := list -}}
{{- $existingWork := list -}}
{{- if hasKey . "work_configs" -}}
{{-   $existingWork = .work_configs -}}
{{- end -}}
{{- $enableWork := true -}}
{{- if $interactive -}}
{{-   $enableWork = promptBool "Do you want to configure Work Git accounts? (y/n)" (gt (len $existingWork) 0) -}}
{{- end -}}

{{- if $enableWork -}}
{{-   if $interactive -}}
{{-     $defaultWorkCount := len $existingWork | int64 -}}
{{-     $workCount := promptInt "How many work configurations do you have? (e.g. 1 or 2)" $defaultWorkCount -}}
{{-     $workCountInt := int $workCount -}}
{{-     if gt $workCountInt 0 -}}
{{-       range $i := until $workCountInt -}}
{{-         $idx := add $i 1 -}}
{{-         $defaultLabel := printf "work-%d" $idx -}}
{{-         $defaultDir := printf "~/workspace/work-%d" $idx -}}
{{-         $defaultEmail := "" -}}
{{-         $defaultName := $name -}}
{{-         $defaultSigningKey := "" -}}
{{-         if lt $i (len $existingWork) -}}
{{-           $ex := index $existingWork $i -}}
{{-           if hasKey $ex "dir" }}{{ if $ex.dir }}{{ $defaultDir = $ex.dir }}{{ end }}{{ end -}}
{{-           if hasKey $ex "label" }}{{ if $ex.label }}{{ $defaultLabel = $ex.label }}{{ end }}{{ else if hasKey $ex "dir" }}{{ if $ex.dir }}{{ $defaultLabel = base $ex.dir }}{{ end }}{{ end -}}
{{-           if hasKey $ex "email" }}{{ if $ex.email }}{{ $defaultEmail = $ex.email }}{{ end }}{{ end -}}
{{-           if hasKey $ex "name" }}{{ if $ex.name }}{{ $defaultName = $ex.name }}{{ end }}{{ end -}}
{{-           if hasKey $ex "signing_key" }}{{ if $ex.signing_key }}{{ $defaultSigningKey = $ex.signing_key }}{{ end }}{{ end -}}
{{-         end -}}
{{-         $label := promptString (printf "Short label for Work %d (e.g. ocn, ghtk -> ~/.gitconfig-<label>)" $idx) $defaultLabel -}}
{{-         $label = $label | lower | replace " " "-" -}}
{{-         if eq $defaultDir (printf "~/workspace/work-%d" $idx) -}}
{{-           $defaultDir = printf "~/workspace/%s" $label -}}
{{-         end -}}
{{-         $dir := promptString (printf "DIRECTORY for Work %d (e.g. ~/workspace/%s)" $idx $label) $defaultDir -}}
{{-         $workEmail := promptString (printf "Git email address for Work %d" $idx) $defaultEmail -}}
{{-         $workName := promptString (printf "Git full name for Work %d" $idx) $defaultName -}}
{{-         $workSigningKey := $defaultSigningKey -}}
{{-         if and (not $workSigningKey) (or (contains "ocn" $workEmail) (contains "ocn" $label) (contains "ocn" $dir)) -}}
{{-           $workSigningKey = "4EB1EAD1D65D87F3" -}}
{{-         end -}}
{{-         $workConfigs = append $workConfigs (dict "dir" $dir "label" $label "email" $workEmail "name" $workName "signing_key" $workSigningKey) -}}
{{-       end -}}
{{-     end -}}
{{-   else -}}
{{/* Fallback to env vars for CI/non-interactive mode */}}
{{-     $workGitDir := env "CHEZMOI_WORK_GIT_DIR" -}}
{{-     if $workGitDir -}}
{{-       $workLabel := env "CHEZMOI_WORK_GIT_LABEL" -}}
{{-       $workEmail := env "CHEZMOI_WORK_GIT_EMAIL" -}}
{{-       $workName := env "CHEZMOI_WORK_GIT_NAME" -}}
{{-       $workSigningKey := env "CHEZMOI_WORK_GIT_SIGNING_KEY" -}}
{{-       $workLabel = $workLabel | default "work-1" | lower | replace " " "-" -}}
{{-       $workConfigs = append $workConfigs (dict "dir" $workGitDir "label" $workLabel "email" $workEmail "name" $workName "signing_key" $workSigningKey) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

encryption = "age"
{{- /* Prefer the workspace checkout when it exists; otherwise pin wherever
       the source actually lives (fresh clone, container, CI). A hardcoded
       path broke apply on any machine without that exact layout. */}}
{{- $workspaceSrc := joinPath .chezmoi.homeDir "workspace/personal/projects/dotfiles" }}
{{- if stat (joinPath $workspaceSrc ".chezmoi.toml.tmpl") }}
sourceDir = {{ $workspaceSrc | quote }}
{{- else }}
sourceDir = {{ .chezmoi.sourceDir | quote }}
{{- end }}

[data]
    email = {{ printf "%q" $email }}
    github_user = {{ printf "%q" $githubUser }}
    name = {{ printf "%q" $name }}
    signing_key = {{ printf "%q" $signingKey }}
    
    # Work Configurations
    work_configs = [
        {{- range $i, $config := $workConfigs }}
        { dir = {{ printf "%q" $config.dir }}, label = {{ printf "%q" $config.label }}, name = {{ printf "%q" $config.name }}, email = {{ printf "%q" $config.email }}{{ if hasKey $config "signing_key" }}, signing_key = {{ printf "%q" $config.signing_key }}{{ end }} },
        {{- end }}
    ]
    enable_dock = {{ $enableDock }}
    enable_mas_apps = {{ $enableMasApps }}
    enable_personal_apps = {{ $enablePersonalApps }}
    enable_ssh_keygen = {{ $enableSshKeygen }}
    enable_mac_keybindings = {{ $enableMacKeybindings }}

[apply]
    backup = true

[age]
    identity = "~/.config/chezmoi/chezmoi_private_key"
    recipient = "age1tc9lzhe5dtptgc7svn5mw0d062fnuav4zfgck8pft84dpc2vydzqak5hsa"

[edit]
    command = "nvim"
